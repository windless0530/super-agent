#!/usr/bin/env python3
"""sactl:worker 角色.bot 与 sa-coordinator 的唯一上报通道。

子命令:
  report  提交完成/升级事件(POST /report)
  task    查看任务(show)
  ingest  任务消息接入(POST /ingest,幂等)
  route   提交 Router verdict(POST /route)
  clarified 澄清答复上报(POST /clarified)

退出码:0 = accepted 或 duplicate;3 = 服务端拒绝(422);4 = 不可达。
幂等:event_id 每次调用生成一次,跨重试复用;服务端按 event_id 去重。
"""

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request
import uuid

DEFAULT_URL = "http://127.0.0.1:8787"
RETRIES = 3
BACKOFF = (1, 2, 4)


def _base_url(args_url: str | None) -> str:
    return (args_url or os.environ.get("SA_COORDINATOR_URL") or DEFAULT_URL).rstrip("/")


def _post(url: str, body: dict) -> tuple[int, dict]:
    """带重试的 POST;返回 (http_status, body)。重试耗尽抛最后异常。"""
    last_exc = None
    for attempt in range(RETRIES):
        try:
            req = urllib.request.Request(
                url, data=json.dumps(body, ensure_ascii=False).encode(),
                headers={"Content-Type": "application/json; charset=utf-8"},
                method="POST",
            )
            with urllib.request.urlopen(req, timeout=10) as resp:
                return resp.status, json.loads(resp.read() or b"{}")
        except urllib.error.HTTPError as e:
            # 422/409 是确定性拒绝(报文不合法/任务非 running):不重试
            if e.code in (422, 409):
                return e.code, json.loads(e.read() or b"{}")
            last_exc = e
        except (urllib.error.URLError, OSError, TimeoutError) as e:
            last_exc = e
        if attempt < RETRIES - 1:
            time.sleep(BACKOFF[attempt])
    raise last_exc


def _get(url: str) -> dict:
    with urllib.request.urlopen(url, timeout=10) as resp:
        return json.loads(resp.read() or b"{}")


def cmd_report(args) -> int:
    payload = {}
    if args.payload_file:
        with open(args.payload_file, encoding="utf-8") as f:
            payload = json.load(f)
    event = {
        "event_id": str(uuid.uuid4()),  # 生成一次,重试复用
        "taskid": args.taskid,
        "outcome": args.outcome,
        "phase": args.phase,
        "source_msg_id": args.source_msg_id,
        "doc_version": args.doc_version,
        "payload": payload,
    }
    url = _base_url(args.url) + "/report"
    try:
        status, body = _post(url, event)
    except Exception as e:  # noqa: BLE001
        print(f"sactl: 不可达 {url}: {e}", file=sys.stderr)
        return 4
    if status in (422, 409):
        print(f"sactl: 被拒绝: {body.get('error') or body.get('reason')}", file=sys.stderr)
        return 3
    print(json.dumps(body, ensure_ascii=False))
    return 0


def cmd_task(args) -> int:
    url = _base_url(args.url) + f"/tasks?taskid={args.taskid}"
    try:
        body = _get(url)
    except Exception as e:  # noqa: BLE001
        print(f"sactl: 不可达 {url}: {e}", file=sys.stderr)
        return 4
    print(json.dumps(body, ensure_ascii=False, indent=2))
    return 0


def cmd_ingest(args) -> int:
    """v1.2 固定动作 1:Router 会话收到任务消息后先落库、加 Get、取 taskid。"""
    body = {
        "message_id": args.message_id,
        "chat_id": args.chat_id,
        "root_msg_id": args.root_msg_id,
        "text": args.text,
    }
    if args.sender_open_id:
        body["sender_open_id"] = args.sender_open_id
    url = _base_url(args.url) + "/ingest"
    try:
        status, resp = _post(url, body)
    except Exception as e:  # noqa: BLE001
        print(f"sactl: 不可达 {url}: {e}", file=sys.stderr)
        return 4
    if status in (422, 409):
        print(f"sactl: 被拒绝: {resp.get('error') or resp.get('reason')}", file=sys.stderr)
        return 3
    print(json.dumps(resp, ensure_ascii=False))
    return 0


def cmd_route(args) -> int:
    """v1.2 固定动作 2/3:提交 Router verdict(歧义提问或类型+标题)。"""
    raw = args.json
    if raw == "-":
        raw = sys.stdin.read()
    try:
        verdict = json.loads(raw)
        if not isinstance(verdict, dict):
            raise ValueError("verdict 必须是 JSON 对象")
    except ValueError as e:
        print(f"sactl: verdict 非法 JSON: {e}", file=sys.stderr)
        return 2
    body = {"taskid": args.taskid, **verdict}
    url = _base_url(args.url) + "/route"
    try:
        status, resp = _post(url, body)
    except Exception as e:  # noqa: BLE001
        print(f"sactl: 不可达 {url}: {e}", file=sys.stderr)
        return 4
    if status in (422, 409):
        print(f"sactl: 被拒绝: {resp.get('error') or resp.get('reason')}", file=sys.stderr)
        return 3
    print(json.dumps(resp, ensure_ascii=False))
    return 0


def cmd_confirm(args) -> int:
    """确认 awaiting_go 任务并派单;重复确认幂等。"""
    url = _base_url(args.url) + "/confirm"
    try:
        status, resp = _post(url, {"taskid": args.taskid})
    except Exception as e:  # noqa: BLE001
        print(f"sactl: 不可达 {url}: {e}", file=sys.stderr)
        return 4
    if status in (422, 409):
        print(f"sactl: 被拒绝: {resp.get('error') or resp.get('reason')}", file=sys.stderr)
        return 3
    print(json.dumps(resp, ensure_ascii=False))
    return 0


def _types_conn(db_path: str | None):
    import os
    import sqlite3
    path = db_path or os.environ.get("SA_DB") or "registry/tasks.db"
    if not os.path.exists(path):
        print(f"sactl: 数据库不存在: {path}(先 init-db)", file=sys.stderr)
        raise SystemExit(4)
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    return conn


def cmd_types(args) -> int:
    """类型注册表运维:set-group 回填群、set-member 回填 mention 令牌、show 查看。"""
    if args.action == "set-group" and not (args.arg1 and args.arg2):
        print("sactl: set-group 需要 <type_code> <chat_id>", file=sys.stderr)
        return 3
    if args.action == "set-member" and not (args.arg1 and args.arg2):
        print("sactl: set-member 需要 <role> <mention>", file=sys.stderr)
        return 3
    conn = _types_conn(args.db)
    try:
        if args.action == "set-group":
            cur = conn.execute(
                "UPDATE task_types SET group_chat_id=? WHERE type_code=? AND enabled=1",
                (args.arg2, args.arg1),
            )
            if cur.rowcount == 0:
                print(f"sactl: 未知或未启用的类型: {args.arg1}", file=sys.stderr)
                return 3
            conn.commit()
            print(f"ok: {args.arg1} -> {args.arg2}")
            return 0
        if args.action == "set-member":
            conn.execute(
                "INSERT INTO role_members(role, mention) VALUES(?,?)"
                " ON CONFLICT(role) DO UPDATE SET mention=excluded.mention",
                (args.arg1, args.arg2),
            )
            conn.commit()
            print(f"ok: {args.arg1} -> {args.arg2}")
            return 0
        # show
        rows = []
        for r in conn.execute(
            "SELECT type_code, name, group_chat_id, roles, rounds_limit,"
            " needs_doc, can_dev, enabled FROM task_types ORDER BY type_code"
        ):
            members = {m["role"]: m["mention"] for m in conn.execute(
                "SELECT role, mention FROM role_members")}
            row = dict(r)
            row["roles"] = json.loads(row["roles"])
            row["members"] = {k: v for k, v in members.items()
                              if k in row["roles"]}
            rows.append(row)
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0
    finally:
        conn.close()


def cmd_clarified(args) -> int:
    """澄清答复上报:回到可路由态(--new-task 则作为新任务接入)。"""
    body = {"taskid": args.taskid, "answer": args.answer,
            "is_new_task": bool(args.new_task)}
    if args.message_id:
        body["message_id"] = args.message_id
    if args.chat_id:
        body["chat_id"] = args.chat_id
    if args.root_msg_id:
        body["root_msg_id"] = args.root_msg_id
    url = _base_url(args.url) + "/clarified"
    try:
        status, resp = _post(url, body)
    except Exception as e:  # noqa: BLE001
        print(f"sactl: 不可达 {url}: {e}", file=sys.stderr)
        return 4
    if status in (422, 409):
        print(f"sactl: 被拒绝: {resp.get('error') or resp.get('reason')}", file=sys.stderr)
        return 3
    print(json.dumps(resp, ensure_ascii=False))
    return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="sactl", description=__doc__)
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("report", help="提交完成/升级事件")
    p.add_argument("--taskid", required=True)
    p.add_argument("--outcome", required=True, choices=["completed", "escalated"])
    p.add_argument("--phase", required=True)
    p.add_argument("--source-msg-id", required=True)
    p.add_argument("--doc-version", required=True)
    p.add_argument("--payload-file", help="JSON 文件(分歧卡片/摘要/文档链接)")
    p.add_argument("--url", help="coordinator 地址(默认环境变量 SA_COORDINATOR_URL)")
    p.set_defaults(func=cmd_report)

    p = sub.add_parser("task", help="查看任务")
    p.add_argument("action", choices=["show"])
    p.add_argument("taskid_arg", metavar="taskid")
    p.add_argument("--url")
    p.set_defaults(func=cmd_task)

    p = sub.add_parser("ingest", help="任务消息接入(幂等,返回 taskid)")
    p.add_argument("--message-id", required=True)
    p.add_argument("--chat-id", required=True)
    p.add_argument("--root-msg-id", required=True)
    p.add_argument("--text", required=True)
    p.add_argument("--sender-open-id")
    p.add_argument("--url")
    p.set_defaults(func=cmd_ingest)

    p = sub.add_parser("route", help="提交 Router verdict(歧义或类型+标题)")
    p.add_argument("--taskid", required=True)
    p.add_argument("--json", required=True,
                   help="verdict JSON 对象;传 - 从 stdin 读")
    p.add_argument("--url")
    p.set_defaults(func=cmd_route)

    p = sub.add_parser("confirm", help="确认 awaiting_go 任务并派单")
    p.add_argument("--taskid", required=True)
    p.add_argument("--url")
    p.set_defaults(func=cmd_confirm)

    p = sub.add_parser("clarified", help="澄清答复上报(可再路由或转新任务)")
    p.add_argument("--taskid", required=True)
    p.add_argument("--answer", required=True)
    p.add_argument("--new-task", action="store_true",
                   help="答复识别为新任务原文(原任务保持 clarifying)")
    p.add_argument("--message-id", help="答复消息 id(幂等去重)")
    p.add_argument("--chat-id")
    p.add_argument("--root-msg-id")
    p.add_argument("--url")
    p.set_defaults(func=cmd_clarified)

    p = sub.add_parser("types", help="类型注册表运维(本地库)")
    p.add_argument("action", choices=["set-group", "set-member", "show"])
    p.add_argument("arg1", nargs="?",
                   help="set-group=type_code / set-member=role")
    p.add_argument("arg2", nargs="?",
                   help="set-group=chat_id / set-member=mention(ou_xxx:显示名)")
    p.add_argument("--db", help="registry/tasks.db 路径(默认环境变量 SA_DB)")
    p.set_defaults(func=cmd_types)

    args = parser.parse_args(argv)
    if args.cmd == "task":
        args.taskid = args.taskid_arg
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
