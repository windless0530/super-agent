[Unit]
Description=Super-agent control-chat IM polling fastpath
After=network-online.target sa-coordinator.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/workspace/super-agent
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ubuntu/.config/super-agent/sa.env
EnvironmentFile=/home/ubuntu/.config/super-agent/im-watcher.env
ExecStart=/usr/bin/python3 tools/im_watcher.py $SA_IM_WATCHER_ARGS
Restart=always
RestartSec=5s
TimeoutStopSec=15s

[Install]
WantedBy=default.target
