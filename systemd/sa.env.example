# 复制到 ~/.config/super-agent/sa.env 后按现场值填写。
# botmux send 在宿主/常驻进程中必须绑定完整 session UUID；短 ID 会 lookup miss。
SA_BOTMUX_SESSION_ID=replace-with-full-botmux-session-uuid

# 可选：覆盖 P0 校准后的命令模板。
# SA_SEND_CMD=botmux send --chat-id {chat_id} {text}
# SA_REPLY_CMD=botmux send --into {root} {text}
# SA_REACTION_CMD=lark-cli im reactions create --message-id {msg_id} --data {reaction_body} --as bot
