[Unit]
Description=Super-agent deterministic coordinator
After=network-online.target botmux.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/workspace/super-agent
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ubuntu/.config/super-agent/sa.env
ExecStart=/usr/bin/python3 -m services.coordinator --db registry/tasks.db serve --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3s
TimeoutStopSec=15s

[Install]
WantedBy=default.target
