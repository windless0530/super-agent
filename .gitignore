__pycache__/
registry/
tasks/
.venv/
# per-bot 会话级模型凭据(含 ANTHROPIC_AUTH_TOKEN,绝不入库)
bots/*/.claude/settings.json
bots/*/.claude/settings.local.json

# 本地 harness 目录(worktree、会话设置),不入库
.claude/
.superpowers/

# worker 会话运行产物不入库(仅保留 CLAUDE.md 与 .claude/skills 挂载)
bots/*/*
!bots/*/CLAUDE.md
!bots/*/.claude
bots/*/.claude/*
!bots/*/.claude/skills
!bots/*/.claude/skills/**
